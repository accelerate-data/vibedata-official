{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/accelerate-data/vibedata-official/schema/catalog.schema.json",
  "title": "vibedata-official storefront catalog",
  "description": "catalog/catalog.json, generated by scripts/build_catalog.py. One entry per listed item, per content type. Never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugins", "skills", "recipes", "connectors", "mcp"],
      "properties": {
        "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
        "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } },
        "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
        "mcp": { "type": "array", "items": { "$ref": "#/$defs/mcp" } }
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "license", "source", "install"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "author": { "type": "string" },
        "source": { "type": "string" },
        "install": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "plugin", "path"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "plugin": { "type": ["string", "null"] },
        "path": { "type": "string" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "area", "readiness"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "pitch": { "type": "string" },
        "area": { "type": "string" },
        "readiness": { "type": "string" }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "url", "ref", "license", "attribution"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "ref": { "type": "string" },
        "license": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "runtime": { "type": "string" },
        "serverUserType": { "type": "string" },
        "url": { "type": "string" }
      }
    }
  }
}
