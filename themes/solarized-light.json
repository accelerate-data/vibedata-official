{
  "id": "solarized-light",
  "name": "Solarized Light",
  "scheme": "light",
  "source": "https://github.com/altercation/solarized",
  "author": "Ethan Schoonover",
  "license": "MIT",
  "attribution": "Solarized by Ethan Schoonover",
  "changes": [
    "text-secondary: #657B83 -> #5E737A to reach 4.5:1 on #FDF6E3",
    "control-border: #D9D2BE -> #9D8C5C to reach 3.0:1 on #FDF6E3",
    "action so on-action stays readable: #268BD2 -> #2074AF to reach 4.5:1 on #FDF6E3",
    "status: #859900 -> #819400 to reach 3.0:1 on #FDF6E3",
    "status: #B58900 -> #B08500 to reach 3.0:1 on #FDF6E3",
    "code surface: #EEE8D5 -> #303C40: .vd-code paints a fixed light ink (#D1EFF7) on --vd-code-surface, so a light code surface is unreadable"
  ],
  "roles": {
    "--vd-surface": "#FDF6E3",
    "--vd-surface-subtle": "#EEE8D5",
    "--vd-surface-raised": "#FDF6E3",
    "--vd-surface-brand": "#DEE4DC",
    "--vd-text": "#586E75",
    "--vd-text-secondary": "#5E737A",
    "--vd-control-border": "#9D8C5C",
    "--vd-action": "#2074AF",
    "--vd-on-action": "#FDF6E3",
    "--vd-focus": "#2074AF",
    "--vd-line": "#9D8C5C",
    "--vd-field": "#FDF6E3",
    "--vd-tint": "#DEE4DC",
    "--vd-soft": "#EEE8D5",
    "--vd-muted": "#5E737A",
    "--vd-divider": "#D9D2BE",
    "--vd-panel-line": "transparent",
    "--vd-badge-fill": "#FDF6E3",
    "--vd-badge-line": "#D9D2BE",
    "--vd-code-surface": "#303C40",
    "--vd-scrim": "rgba(88, 110, 117, 0.55)",
    "--vd-status-success": "#819400",
    "--vd-status-warning": "#B08500",
    "--vd-status-error": "#DC322F",
    "--vd-status-success-tint": "#EEEAC8",
    "--vd-status-warning-tint": "#F4E8C8",
    "--vd-status-error-tint": "#F9DECD",
    "--vd-chart-1": "#2074AF",
    "--vd-chart-2": "#6C71C4",
    "--vd-chart-3": "#D33682",
    "--vd-chart-4": "#4672BA",
    "--vd-chart-outline": "#2074AF",
    "--vd-chart-grid": "#D9D2BE",
    "--vd-heat-0": "#EEE8D5",
    "--vd-heat-1": "#BBCFD3",
    "--vd-heat-2": "#83AEC6",
    "--vd-heat-3": "#5191BA",
    "--vd-heat-4": "#2074AF"
  }
}
