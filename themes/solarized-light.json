{
  "id": "solarized-light",
  "name": "Solarized Light",
  "scheme": "light",
  "source": "https://github.com/altercation/solarized",
  "author": "Ethan Schoonover",
  "license": "MIT",
  "attribution": "Solarized by Ethan Schoonover",
  "changes": [
    "text-secondary: #657B83 -> #5E737A to reach 4.5:1 on #FDF6E3",
    "control-border: #D9D2BE -> #9D8C5C to reach 3.0:1 on #FDF6E3",
    "action so on-action stays readable: #268BD2 -> #2074AF to reach 4.5:1 on #FDF6E3",
    "status: #859900 -> #819400 to reach 3.0:1 on #FDF6E3",
    "status: #B58900 -> #B08500 to reach 3.0:1 on #FDF6E3",
    "code surface: #EEE8D5 -> #303C40: .vd-code paints a fixed light ink (#D1EFF7) on --vd-code-surface, so a light code surface is unreadable",
    "--vd-status-success: #819400 -> #5D6B00 to reach 4.55:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 2.63:1)",
    "--vd-status-warning: #B08500 -> #7D5E00 to reach 4.68:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 2.62:1)",
    "--vd-status-error: #DC322F -> #C22321 to reach 4.57:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 3.58:1)",
    "--vd-code-surface: #303C40 -> #191F21 to keep the code block's fixed metadata ink at 4.60:1 (was 3.14:1)",
    "--vd-text: #586E75 -> #53686F to reach 4.5:1 on --vd-tint, --vd-surface-subtle, --vd-surface-brand (worst was 4.16:1, now 4.54:1)",
    "--vd-text-secondary: #5E737A -> #55686F to reach 4.5:1 on --vd-tint, --vd-surface-subtle, --vd-surface-brand (worst was 3.86:1, now 4.52:1)",
    "--vd-muted: #5E737A -> #586B72 to reach 4.5:1 on --vd-surface-subtle (worst was 4.07:1, now 4.56:1)",
    "--vd-control-border: #9D8C5C -> #938456 to reach 3.0:1 on --vd-surface, --vd-field, --vd-surface-raised, --vd-surface-subtle (worst was 2.70:1, now 3.02:1)",
    "--vd-link: added as #1D689E (action #2074AF adjusted to reach 4.5:1 on every ground a link sits on; worst was 3.89:1); --vd-surface-hover: added as #DEE4DC (the brand surface, as the design system's own light theme does), both roles the design system's theme contract now requires"
  ],
  "roles": {
    "--vd-surface": "#FDF6E3",
    "--vd-surface-subtle": "#EEE8D5",
    "--vd-surface-raised": "#FDF6E3",
    "--vd-surface-brand": "#DEE4DC",
    "--vd-text": "#53686F",
    "--vd-text-secondary": "#55686F",
    "--vd-control-border": "#938456",
    "--vd-action": "#2074AF",
    "--vd-on-action": "#FDF6E3",
    "--vd-focus": "#2074AF",
    "--vd-line": "#9D8C5C",
    "--vd-field": "#FDF6E3",
    "--vd-tint": "#DEE4DC",
    "--vd-soft": "#EEE8D5",
    "--vd-muted": "#586B72",
    "--vd-divider": "#D9D2BE",
    "--vd-panel-line": "transparent",
    "--vd-badge-fill": "#FDF6E3",
    "--vd-badge-line": "#D9D2BE",
    "--vd-code-surface": "#191F21",
    "--vd-scrim": "rgba(88, 110, 117, 0.55)",
    "--vd-status-success": "#5D6B00",
    "--vd-status-warning": "#7D5E00",
    "--vd-status-error": "#C22321",
    "--vd-status-success-tint": "#EEEAC8",
    "--vd-status-warning-tint": "#F4E8C8",
    "--vd-status-error-tint": "#F9DECD",
    "--vd-chart-1": "#2074AF",
    "--vd-chart-2": "#6C71C4",
    "--vd-chart-3": "#D33682",
    "--vd-chart-4": "#4672BA",
    "--vd-chart-outline": "#2074AF",
    "--vd-chart-grid": "#D9D2BE",
    "--vd-heat-0": "#EEE8D5",
    "--vd-heat-1": "#BBCFD3",
    "--vd-heat-2": "#83AEC6",
    "--vd-heat-3": "#5191BA",
    "--vd-heat-4": "#2074AF",
    "--vd-link": "#1D689E",
    "--vd-surface-hover": "#DEE4DC"
  }
}
