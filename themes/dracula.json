{
  "id": "dracula",
  "name": "Dracula",
  "scheme": "dark",
  "source": "https://github.com/dracula/dracula-theme",
  "author": "Zeno Rocha",
  "license": "MIT",
  "attribution": "Dracula by Zeno Rocha",
  "changes": [
    "control-border: #44475A -> #6E7391 to reach 3.0:1 on #282A36",
    "--vd-status-error: #FF5555 -> #FF9292 to reach 4.59:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 3.14:1)",
    "--vd-code-surface: #21222C -> #1D1D26 to keep the code block's fixed metadata ink at 4.61:1 (was 4.36:1)"
  ],
  "roles": {
    "--vd-surface": "#282A36",
    "--vd-surface-subtle": "#343746",
    "--vd-surface-raised": "#343746",
    "--vd-surface-brand": "#463F5D",
    "--vd-text": "#F8F8F2",
    "--vd-text-secondary": "#A6A9BC",
    "--vd-control-border": "#6E7391",
    "--vd-action": "#BD93F9",
    "--vd-on-action": "#282A36",
    "--vd-focus": "#BD93F9",
    "--vd-line": "#6E7391",
    "--vd-field": "#343746",
    "--vd-tint": "#463F5D",
    "--vd-soft": "#343746",
    "--vd-muted": "#A6A9BC",
    "--vd-divider": "rgba(248, 248, 242, 0.24)",
    "--vd-panel-line": "#6E7391",
    "--vd-badge-fill": "#463F5D",
    "--vd-badge-line": "#6E7391",
    "--vd-code-surface": "#1D1D26",
    "--vd-scrim": "rgba(0, 0, 0, 0.6)",
    "--vd-status-success": "#50FA7B",
    "--vd-status-warning": "#FFB86C",
    "--vd-status-error": "#FF9292",
    "--vd-status-success-tint": "transparent",
    "--vd-status-warning-tint": "transparent",
    "--vd-status-error-tint": "transparent",
    "--vd-chart-1": "#BD93F9",
    "--vd-chart-2": "#8BE9FD",
    "--vd-chart-3": "#FF79C6",
    "--vd-chart-4": "#A4BEFB",
    "--vd-chart-outline": "#BD93F9",
    "--vd-chart-grid": "rgba(248, 248, 242, 0.24)",
    "--vd-heat-0": "#343746",
    "--vd-heat-1": "#554A70",
    "--vd-heat-2": "#7A64A1",
    "--vd-heat-3": "#9C7CCE",
    "--vd-heat-4": "#BD93F9"
