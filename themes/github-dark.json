{
  "id": "github-dark",
  "name": "GitHub Dark",
  "scheme": "dark",
  "source": "https://github.com/primer/github-vscode-theme",
  "author": "GitHub",
  "license": "MIT",
  "attribution": "GitHub Dark, from GitHub's Primer palette",
  "changes": [
    "control-border: #30363D -> #56616E to reach 3.0:1 on #0D1117",
    "action so on-action stays readable: #2F81F7 -> #126FF6 to reach 4.5:1 on #FFFFFF",
    "--vd-control-border: #56616E -> #5C6875 to reach 3.0:1 on --vd-surface, --vd-field, --vd-surface-raised, --vd-surface-subtle (worst was 2.74:1, now 3.04:1)",
    "--vd-link: added as #3D89F8 (focus #126FF6 adjusted to reach 4.5:1 on every ground a link sits on; worst was 3.42:1); --vd-surface-hover: added as #0D1117 (the page surface, as the design system's own dark theme does), both roles the design system's theme contract now requires"
  ],
  "roles": {
    "--vd-surface": "#0D1117",
    "--vd-surface-subtle": "#161B22",
    "--vd-surface-raised": "#161B22",
    "--vd-surface-brand": "#0E2444",
    "--vd-text": "#E6EDF3",
    "--vd-text-secondary": "#8B949E",
    "--vd-control-border": "#5C6875",
    "--vd-action": "#126FF6",
    "--vd-on-action": "#FFFFFF",
    "--vd-focus": "#126FF6",
    "--vd-line": "#56616E",
    "--vd-field": "#161B22",
    "--vd-tint": "#0E2444",
    "--vd-soft": "#161B22",
    "--vd-muted": "#8B949E",
    "--vd-divider": "rgba(230, 237, 243, 0.24)",
    "--vd-panel-line": "#56616E",
    "--vd-badge-fill": "#0E2444",
    "--vd-badge-line": "#56616E",
    "--vd-code-surface": "#161B22",
    "--vd-scrim": "rgba(0, 0, 0, 0.6)",
    "--vd-status-success": "#3FB950",
    "--vd-status-warning": "#D29922",
    "--vd-status-error": "#F85149",
    "--vd-status-success-tint": "transparent",
    "--vd-status-warning-tint": "transparent",
    "--vd-status-error-tint": "transparent",
    "--vd-chart-1": "#126FF6",
    "--vd-chart-2": "#A371F7",
    "--vd-chart-3": "#DB61A2",
    "--vd-chart-4": "#5A70F6",
    "--vd-chart-outline": "#126FF6",
    "--vd-chart-grid": "rgba(230, 237, 243, 0.24)",
    "--vd-heat-0": "#161B22",
    "--vd-heat-1": "#0E2D5A",
    "--vd-heat-2": "#104592",
    "--vd-heat-3": "#115AC5",
    "--vd-heat-4": "#126FF6",
    "--vd-link": "#3D89F8",
    "--vd-surface-hover": "#0D1117"
  }
}
