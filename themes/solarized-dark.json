    "--vd-surface-brand": "#0A4057",
    "--vd-text": "#93A1A1",
    "--vd-text-secondary": "#8B9B9D",
    "--vd-control-border": "#187C93",
    "--vd-action": "#3295DA",
    "--vd-on-action": "#002B36",
    "--vd-focus": "#3295DA",
    "--vd-line": "#187C93",
    "--vd-field": "#073642",
    "--vd-tint": "#0A4057",
    "--vd-soft": "#073642",
    "--vd-muted": "#8B9B9D",
    "--vd-divider": "rgba(147, 161, 161, 0.24)",
