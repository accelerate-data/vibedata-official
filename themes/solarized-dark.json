{
  "id": "solarized-dark",
  "name": "Solarized Dark",
  "scheme": "dark",
  "source": "https://github.com/altercation/solarized",
  "author": "Ethan Schoonover",
  "license": "MIT",
  "attribution": "Solarized by Ethan Schoonover",
  "changes": [
    "text-secondary on raised: #839496 -> #8B9B9D to reach 4.5:1 on #073642",
    "control-border: #0F4C5A -> #187C93 to reach 3.0:1 on #002B36",
    "action so on-action stays readable: #268BD2 -> #3295DA to reach 4.5:1 on #002B36",
    "--vd-status-success: #859900 -> #9BB300 to reach 4.69:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 3.48:1)",
    "--vd-status-warning: #B58900 -> #D4A000 to reach 4.69:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 3.47:1)",
    "--vd-status-error: #DC322F -> #EB8C8B to reach 4.60:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 2.41:1)",
    "--vd-code-surface: #073642 -> #042129 to keep the code block's fixed metadata ink at 4.62:1 (was 3.59:1)",
    "--vd-text: #93A1A1 -> #9BA8A8 to reach 4.5:1 on --vd-tint, --vd-surface-brand (worst was 4.17:1, now 4.54:1)",
    "--vd-text-secondary: #8B9B9D -> #9AA8A9 to reach 4.5:1 on --vd-tint, --vd-surface-brand (worst was 3.86:1, now 4.54:1)",
    "--vd-control-border: #187C93 -> #1A859D to reach 3.0:1 on --vd-surface, --vd-field, --vd-surface-raised, --vd-surface-subtle (worst was 2.69:1, now 3.02:1)",
    "--vd-link: added as #5FACE2 (focus #3295DA adjusted to reach 4.5:1 on every ground a link sits on; worst was 3.42:1); --vd-surface-hover: added as #002B36 (the page surface, as the design system's own dark theme does), both roles the design system's theme contract now requires"
  ],
  "roles": {
    "--vd-surface": "#002B36",
    "--vd-surface-subtle": "#073642",
    "--vd-surface-raised": "#073642",
    "--vd-surface-brand": "#0A4057",
    "--vd-text": "#9BA8A8",
    "--vd-text-secondary": "#9AA8A9",
    "--vd-control-border": "#1A859D",
    "--vd-action": "#3295DA",
    "--vd-on-action": "#002B36",
    "--vd-focus": "#3295DA",
    "--vd-line": "#187C93",
    "--vd-field": "#073642",
    "--vd-tint": "#0A4057",
    "--vd-soft": "#073642",
    "--vd-muted": "#8B9B9D",
    "--vd-divider": "rgba(147, 161, 161, 0.24)",
    "--vd-panel-line": "#187C93",
    "--vd-badge-fill": "#0A4057",
    "--vd-badge-line": "#187C93",
    "--vd-code-surface": "#042129",
    "--vd-scrim": "rgba(0, 0, 0, 0.6)",
    "--vd-status-success": "#9BB300",
    "--vd-status-warning": "#D4A000",
    "--vd-status-error": "#EB8C8B",
    "--vd-status-success-tint": "transparent",
    "--vd-status-warning-tint": "transparent",
    "--vd-status-error-tint": "transparent",
    "--vd-chart-1": "#3295DA",
    "--vd-chart-2": "#6C71C4",
    "--vd-chart-3": "#D33682",
    "--vd-chart-4": "#4F83CF",
    "--vd-chart-outline": "#3295DA",
    "--vd-chart-grid": "rgba(147, 161, 161, 0.24)",
    "--vd-heat-0": "#073642",
    "--vd-heat-1": "#0F4B67",
    "--vd-heat-2": "#1C6590",
    "--vd-heat-3": "#277EB6",
    "--vd-heat-4": "#3295DA",
    "--vd-link": "#5FACE2",
    "--vd-surface-hover": "#002B36"
  }
}
