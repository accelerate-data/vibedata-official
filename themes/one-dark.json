{
  "id": "one-dark",
  "name": "One Dark",
  "scheme": "dark",
  "source": "https://github.com/atom/one-dark-syntax",
  "author": "Atom",
  "license": "MIT",
  "attribution": "One Dark, from the Atom One Dark syntax theme",
  "changes": [
    "text-secondary on raised: #8B93A1 -> #939BA8 to reach 4.5:1 on #2F333D",
    "control-border: #3E4451 -> #6A758B to reach 3.0:1 on #282C34",
    "--vd-status-error: #E06C75 -> #EB9FA4 to reach 4.64:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 3.04:1)",
    "--vd-code-surface: #21252B -> #1B1F24 to keep the code block's fixed metadata ink at 4.57:1 (was 4.25:1)"
  ],
  "roles": {
    "--vd-surface": "#282C34",
    "--vd-surface-subtle": "#2F333D",
    "--vd-surface-raised": "#2F333D",
    "--vd-surface-brand": "#334659",
    "--vd-text": "#ABB2BF",
    "--vd-text-secondary": "#939BA8",
    "--vd-control-border": "#6A758B",
    "--vd-action": "#61AFEF",
    "--vd-on-action": "#282C34",
    "--vd-focus": "#61AFEF",
    "--vd-line": "#6A758B",
    "--vd-field": "#2F333D",
    "--vd-tint": "#334659",
    "--vd-soft": "#2F333D",
    "--vd-muted": "#939BA8",
    "--vd-divider": "rgba(171, 178, 191, 0.24)",
    "--vd-panel-line": "#6A758B",
    "--vd-badge-fill": "#334659",
    "--vd-badge-line": "#6A758B",
    "--vd-code-surface": "#1B1F24",
    "--vd-scrim": "rgba(0, 0, 0, 0.6)",
    "--vd-status-success": "#98C379",
    "--vd-status-warning": "#E5C07B",
    "--vd-status-error": "#EB9FA4",
    "--vd-status-success-tint": "transparent",
    "--vd-status-warning-tint": "transparent",
    "--vd-status-error-tint": "transparent",
    "--vd-chart-1": "#61AFEF",
    "--vd-chart-2": "#C678DD",
    "--vd-chart-3": "#56B6C2",
    "--vd-chart-4": "#9494E6",
    "--vd-chart-outline": "#61AFEF",
    "--vd-chart-grid": "rgba(171, 178, 191, 0.24)",
    "--vd-heat-0": "#2F333D",
    "--vd-heat-1": "#39536C",
    "--vd-heat-2": "#47749B",
    "--vd-heat-3": "#5492C6",
    "--vd-heat-4": "#61AFEF"
  }
}
