{
  "id": "catppuccin-latte",
  "name": "Catppuccin Latte",
  "scheme": "light",
  "source": "https://github.com/catppuccin/catppuccin",
  "author": "Catppuccin",
  "license": "MIT",
  "attribution": "Catppuccin Latte",
  "changes": [
    "text-secondary: #6C6F85 -> #6A6D82 to reach 4.5:1 on #EFF1F5",
    "control-border: #BCC0CC -> #828AA0 to reach 3.0:1 on #EFF1F5",
    "status: #40A02B -> #3E9C2A to reach 3.0:1 on #EFF1F5",
    "status: #DF8E1D -> #BF7A19 to reach 3.0:1 on #EFF1F5",
    "code surface: #E6E9EF -> #2A2B3A: .vd-code paints a fixed light ink (#D1EFF7) on --vd-code-surface, so a light code surface is unreadable",
    "--vd-status-success: #3E9C2A -> #2B6C1D to reach 4.75:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 2.59:1)",
    "--vd-status-warning: #BF7A19 -> #845511 to reach 4.72:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 2.58:1)",
    "--vd-status-error: #D20F39 -> #BF0E34 to reach 4.66:1 on --vd-surface, --vd-surface-raised, --vd-surface-brand, --vd-surface-subtle (was 4.01:1)",
    "--vd-code-surface: #2A2B3A -> #1D1E28 to keep the code block's fixed metadata ink at 4.57:1 (was 3.85:1)",
    "--vd-text-secondary: #6A6D82 -> #5E6174 to reach 4.5:1 on --vd-tint, --vd-surface-subtle, --vd-surface-brand (worst was 3.76:1, now 4.51:1)",
    "--vd-muted: #6A6D82 -> #65687C to reach 4.5:1 on --vd-surface-subtle (worst was 4.19:1, now 4.51:1)",
    "--vd-control-border: #828AA0 -> #747D96 to reach 3.0:1 on --vd-surface-subtle, --vd-tint, --vd-surface-brand (worst was 2.55:1, now 3.03:1)"
  ],
  "roles": {
    "--vd-surface": "#EFF1F5",
    "--vd-surface-subtle": "#E6E9EF",
    "--vd-surface-raised": "#FFFFFF",
    "--vd-surface-brand": "#D2DEF5",
    "--vd-text": "#4C4F69",
    "--vd-text-secondary": "#5E6174",
    "--vd-control-border": "#747D96",
    "--vd-action": "#1E66F5",
    "--vd-on-action": "#FFFFFF",
    "--vd-focus": "#1E66F5",
    "--vd-line": "#828AA0",
    "--vd-field": "#FFFFFF",
    "--vd-tint": "#D2DEF5",
    "--vd-soft": "#E6E9EF",
    "--vd-muted": "#65687C",
    "--vd-divider": "#BCC0CC",
    "--vd-panel-line": "transparent",
    "--vd-badge-fill": "#EFF1F5",
    "--vd-badge-line": "#BCC0CC",
    "--vd-code-surface": "#1D1E28",
    "--vd-scrim": "rgba(76, 79, 105, 0.55)",
    "--vd-status-success": "#2B6C1D",
    "--vd-status-warning": "#845511",
    "--vd-status-error": "#BF0E34",
    "--vd-status-success-tint": "#DAE7DD",
    "--vd-status-warning-tint": "#E9E3DB",
    "--vd-status-error-tint": "#ECD6DE",
    "--vd-chart-1": "#1E66F5",
    "--vd-chart-2": "#8839EF",
    "--vd-chart-3": "#EA76CB",
    "--vd-chart-4": "#5350F2",
    "--vd-chart-outline": "#1E66F5",
