{
  "id": "github-light",
  "name": "GitHub Light",
  "scheme": "light",
  "source": "https://github.com/primer/github-vscode-theme",
  "author": "GitHub",
  "license": "MIT",
  "attribution": "GitHub Light, from GitHub's Primer palette",
  "changes": [
    "control-border: #D0D7DE -> #8597A9 to reach 3.0:1 on #FFFFFF",
    "code surface: #F6F8FA -> #111316: .vd-code paints a fixed light ink (#D1EFF7) on --vd-code-surface, so a light code surface is unreadable"
  ],
  "roles": {
    "--vd-surface": "#FFFFFF",
    "--vd-surface-subtle": "#F6F8FA",
    "--vd-surface-raised": "#FFFFFF",
    "--vd-surface-brand": "#DDEAFA",
    "--vd-text": "#1F2328",
    "--vd-text-secondary": "#59636E",
    "--vd-control-border": "#8597A9",
    "--vd-action": "#0969DA",
    "--vd-on-action": "#FFFFFF",
    "--vd-focus": "#0969DA",
    "--vd-line": "#8597A9",
    "--vd-field": "#FFFFFF",
    "--vd-tint": "#DDEAFA",
    "--vd-soft": "#F6F8FA",
    "--vd-muted": "#59636E",
    "--vd-divider": "#D0D7DE",
    "--vd-panel-line": "transparent",
    "--vd-badge-fill": "#FFFFFF",
    "--vd-badge-line": "#D0D7DE",
    "--vd-code-surface": "#111316",
    "--vd-scrim": "rgba(31, 35, 40, 0.55)",
    "--vd-status-success": "#1A7F37",
    "--vd-status-warning": "#9A6700",
    "--vd-status-error": "#CF222E",
    "--vd-status-success-tint": "#E4F0E7",
    "--vd-status-warning-tint": "#F3EDE0",
    "--vd-status-error-tint": "#F9E4E6",
    "--vd-chart-1": "#0969DA",
    "--vd-chart-2": "#8250DF",
    "--vd-chart-3": "#BF3989",
    "--vd-chart-4": "#465CDC",
    "--vd-chart-outline": "#0969DA",
    "--vd-chart-grid": "#D0D7DE",
    "--vd-heat-0": "#F6F8FA",
    "--vd-heat-1": "#B5D2F4",
    "--vd-heat-2": "#78ACEB",
    "--vd-heat-3": "#3F8AE2",
    "--vd-heat-4": "#0969DA"
  }
}
